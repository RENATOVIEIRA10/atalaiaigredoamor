# Atalaia local environment
# Copy this file to .env and fill the values from the approved Supabase/Lovable environment.
# Do not commit real secrets or service-role keys.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backward-compatible name accepted by the app if publishable key is not present.
# Prefer VITE_SUPABASE_PUBLISHABLE_KEY for new environments.
# VITE_SUPABASE_ANON_KEY=
